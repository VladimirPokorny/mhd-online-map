# Copy to .env for `docker compose up`, or paste into Dokploy's Environment tab.

# Timetable source; an empty value turns updates off.
GTFS_URL=https://kordis-jmk.cz/gtfs/gtfs.zip
# How often to check for a new timetable version.
GTFS_UPDATE_INTERVAL_HOURS=6

# Live map of vehicles with their delays (/zive).
LIVE=true
# Car traffic and road closures in Brno on the live map, from dopravniinfo.cz (the endpoints
# of its public map, not a documented API; the official equivalent is the NDIC DATEX II feed).
LIVE_TRAFFIC=true

# History collector and its PostgreSQL database (services db and collector).
# Required. Use letters and digits only: the password is put into a connection URL.
POSTGRES_PASSWORD=
POSTGRES_USER=brno
POSTGRES_DB=brno
# Jobs to switch off, comma-separated, e.g. kordis_stream,events (python -m collector status lists them).
COLLECTOR_DISABLE=
# Keep the KORDIS archive's daily Parquet files (every 30-second sample, ~13 MB a day) in this
# folder of the collector container; /app/raw is a volume. Empty = keep only the database rows.
KORDIS_RAW_DIR=

# Optional Umami analytics. Leave UMAMI_WEBSITE_ID empty to disable tracking.
UMAMI_WEBSITE_ID=
# Defaults to Umami Cloud; for self-hosted use e.g. https://umami.example.com/script.js
UMAMI_SCRIPT_URL=
# Comma-separated hostnames to restrict tracking to, e.g. map.example.com
UMAMI_DOMAINS=
# Session replays and heatmaps (Umami 3.1+): loads recorder.js from the same host
# as UMAMI_SCRIPT_URL. Also switch them on in Umami: Websites > Edit > Replays & Heatmaps.
UMAMI_RECORDER=false
# Origins allowed to frame the pages (needed for the heatmap overlay), space-separated,
# e.g. https://umami.example.com or https://cloud.umami.is. Empty = no CSP header.
UMAMI_FRAME_ANCESTORS=
